NODE_ENV=development
PORT=4000
DISABLE_SCHEDULER=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pandit_booking
PGSSLMODE=disable
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=replace-with-a-long-random-secret
SERVICE_OTP_ENCRYPTION_KEY=replace-with-another-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=10
# Dedicated Google Play review accounts. The fixed OTP applies only to these actor-specific phones.
REVIEW_USER_PHONE=9999999999
REVIEW_PANDIT_PHONE=9876543210
REVIEW_OTP=123456
TIMEOUT_HOURS=2
OTP_PROVIDER=aws
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
# Set only when the sender ID is DLT-registered for transactional SMS in India.
AWS_SNS_SENDER_ID=
AWS_SNS_ENTITY_ID=
AWS_SNS_TEMPLATE_ID=
# This must exactly match the DLT-registered template; use {{OTP}} for the code.
OTP_MESSAGE_TEMPLATE=Your OTP for Pandit Booking is {{OTP}}. It is valid for 5 minutes.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_JSON=
