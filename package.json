{
  "name": "pandit-booking-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "user-app",
    "pandit-app",
    "admin-dashboard",
    "user-web-app"
  ],
  "scripts": {
    "dev": "npm --prefix user-web-app run dev",
    "dev:web": "npm --prefix user-web-app run dev",
    "build": "npm --prefix user-web-app run build",
    "build:web": "npm --prefix user-web-app run build",
    "dev:backend": "npm --workspace backend run dev",
    "dev:user": "npm --workspace user-app start",
    "dev:pandit": "npm --workspace pandit-app start",
    "dev:admin": "npm --workspace admin-dashboard run dev",
    "start:backend": "npm --workspace backend start",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
